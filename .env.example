# Copy this file to .env for local testing (never commit the real .env file).
# In GitHub Actions, these are set as repository Secrets instead - see README.md.

ANTHROPIC_API_KEY=sk-ant-...
IG_ACCESS_TOKEN=...
THREADS_ACCESS_TOKEN=...

# GITHUB_TOKEN is provided automatically inside GitHub Actions.
# For local testing you'd need a personal access token with repo write permission:
GITHUB_TOKEN=ghp_...
GITHUB_REPOSITORY_OWNER=your-github-username
GITHUB_REPOSITORY=your-github-username/roastpro-automation
